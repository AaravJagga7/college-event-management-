{
  "version": 2,
  "name": "rvce-event-intelligence",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "250mb",
        "runtime": "python3.9"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "MODELS_DIR": "reports/models",
    "CHAMPION_METRICS_PATH": "reports/champion_metrics.json",
    "FEATURE_STORE_PATH": "features_ready.csv"
  }
}

